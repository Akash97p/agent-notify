<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied verbatim from packages/crypto/test-vectors.json in the relay
         repository. RelayEnvelopeCryptoTests reproduces every vector byte for
         byte, so a drift between the two implementations fails the build. -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentNotify.Api\AgentNotify.Api.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Cli\AgentNotify.Cli.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Protocol\AgentNotify.Protocol.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Core\AgentNotify.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Router\AgentNotify.Router.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Insights\AgentNotify.Insights.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Desktop\AgentNotify.Desktop.csproj" />
    <ProjectReference Include="..\..\src\AgentNotify.Host\AgentNotify.Host.csproj" />
  </ItemGroup>

</Project>
