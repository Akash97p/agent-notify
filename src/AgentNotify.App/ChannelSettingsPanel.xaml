<UserControl x:Class="AgentNotify.App.ChannelSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827" Foreground="#EEF2FF">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl Background="#111827" Foreground="#EEF2FF">
            <TabItem Header="Providers">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ListBox x:Name="ProviderList" Height="330" DisplayMemberPath="Name" SelectionChanged="Provider_Selected"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="New" Click="NewProvider_Click"/><Button Content="Delete" Click="DeleteProvider_Click"/></WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Outbound provider" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Secrets stay encrypted. Blank secret fields preserve stored values." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Profile name"/><TextBox x:Name="ProviderNameBox"/>
                        <TextBlock Text="Provider type"/><ComboBox x:Name="ProviderKindBox" SelectionChanged="ProviderKind_Changed"><ComboBoxItem Content="Webhook" Tag="webhook"/><ComboBoxItem Content="SMTP email" Tag="smtp"/><ComboBoxItem Content="Telegram Bot" Tag="telegram"/><ComboBoxItem Content="Discord webhook" Tag="discord"/><ComboBoxItem Content="Slack webhook" Tag="slack"/><ComboBoxItem Content="Microsoft Teams Workflows" Tag="teams"/><ComboBoxItem Content="Zoho Cliq webhook" Tag="zoho_cliq"/><ComboBoxItem Content="Google Chat webhook" Tag="google_chat"/><ComboBoxItem Content="Mattermost webhook" Tag="mattermost"/><ComboBoxItem Content="Matrix room" Tag="matrix"/><ComboBoxItem Content="ntfy push" Tag="ntfy"/><ComboBoxItem Content="Gotify push" Tag="gotify"/><ComboBoxItem Content="Pushover" Tag="pushover"/><ComboBoxItem Content="Pushbullet" Tag="pushbullet"/></ComboBox>
                        <CheckBox x:Name="ProviderEnabledBox" Content="Enable this provider"/>
                        <StackPanel x:Name="WebhookFields">
                            <TextBlock Text="HTTPS endpoint URL (encrypted)"/><PasswordBox x:Name="EndpointBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Authorization header value (optional, encrypted)"/><PasswordBox x:Name="AuthorizationBox" Padding="9,7" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ClearAuthorizationBox" Content="Remove stored Authorization value"/>
                            <TextBlock Text="HMAC signing key (optional, encrypted)"/><PasswordBox x:Name="HmacBox" Padding="9,7" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ClearHmacBox" Content="Remove stored HMAC key"/>
                        </StackPanel>
                        <StackPanel x:Name="SmtpFields" Visibility="Collapsed">
                            <TextBlock Text="SMTP host"/><TextBox x:Name="SmtpHostBox"/>
                            <TextBlock Text="Port"/><TextBox x:Name="SmtpPortBox" Text="587"/>
                            <TextBlock Text="Transport security"/><ComboBox x:Name="SmtpSecurityBox"><ComboBoxItem Content="STARTTLS (required)" Tag="start_tls"/><ComboBoxItem Content="TLS on connect" Tag="tls"/></ComboBox>
                            <TextBlock Text="From address"/><TextBox x:Name="SmtpFromBox"/>
                            <TextBlock Text="From display name"/><TextBox x:Name="SmtpFromNameBox" Text="AgentNotify"/>
                            <TextBlock Text="Recipients (semicolon, comma, or new line; maximum 10)"/><TextBox x:Name="SmtpRecipientsBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
                            <TextBlock Text="Subject prefix"/><TextBox x:Name="SmtpSubjectPrefixBox" Text="[AgentNotify] "/>
                            <TextBlock Text="SMTP username (encrypted)"/><PasswordBox x:Name="SmtpUsernameBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="SMTP password/app password (encrypted)"/><PasswordBox x:Name="SmtpPasswordBox" Padding="9,7" Margin="0,0,0,12"/>
                        </StackPanel>
                        <StackPanel x:Name="TelegramFields" Visibility="Collapsed">
                            <TextBlock Text="Bot token from @BotFather (encrypted)"/><PasswordBox x:Name="TelegramTokenBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Chat ID or @channel username (encrypted)"/><PasswordBox x:Name="TelegramChatBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Topic/thread ID (optional)"/><TextBox x:Name="TelegramThreadBox"/>
                            <CheckBox x:Name="TelegramSilentBox" Content="Send silently (no notification sound)"/>
                            <CheckBox x:Name="TelegramProtectBox" Content="Protect message from forwarding and saving" IsChecked="True"/>
                            <TextBlock Text="The user must start the bot first, or the bot must be permitted to post in the destination chat/channel." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="DiscordFields" Visibility="Collapsed">
                            <TextBlock Text="Discord incoming-webhook URL (encrypted)"/><PasswordBox x:Name="DiscordWebhookBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Webhook display name"/><TextBox x:Name="DiscordUsernameBox" Text="AgentNotify"/>
                            <TextBlock Text="Thread ID (optional)"/><TextBox x:Name="DiscordThreadBox"/>
                            <TextBlock Text="Only official discord.com webhook URLs are accepted. User, role, @everyone, and @here mentions are always suppressed." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="SlackFields" Visibility="Collapsed">
                            <TextBlock Text="Slack incoming-webhook URL (encrypted)"/><PasswordBox x:Name="SlackWebhookBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Thread timestamp (optional, for example 1712345678.123456)"/><TextBox x:Name="SlackThreadBox"/>
                            <TextBlock Text="Official Slack and GovSlack webhook hosts are accepted. Slack markup, automatic link names, and control-sequence mentions are suppressed." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="TeamsFields" Visibility="Collapsed">
                            <TextBlock Text="Teams Workflows webhook URL (encrypted)"/><PasswordBox x:Name="TeamsWebhookBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Use the current URL copied from the Teams Workflows app. Legacy Office 365 connector and retired logic.azure.com URLs are not accepted." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="ZohoCliqFields" Visibility="Collapsed">
                            <TextBlock Text="Zoho Cliq channel/bot webhook URL (encrypted)"/><PasswordBox x:Name="ZohoCliqWebhookBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Paste the URL generated from Cliq Webhook Tokens. All nine official Zoho Cliq data-center domains are supported." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="GoogleChatFields" Visibility="Collapsed">
                            <TextBlock Text="Google Chat incoming-webhook URL (encrypted)"/><PasswordBox x:Name="GoogleChatWebhookBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Thread key (optional; starts or reuses one thread)"/><TextBox x:Name="GoogleChatThreadBox"/>
                            <TextBlock Text="If the thread does not exist"/><ComboBox x:Name="GoogleChatReplyPolicyBox"><ComboBoxItem Content="Start a new thread" Tag="fallback"/><ComboBoxItem Content="Fail delivery" Tag="fail"/></ComboBox>
                            <TextBlock Text="Paste the complete URL copied from the Google Chat space. AgentNotify suppresses user/everyone mentions and keeps the key and token encrypted." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="MattermostFields" Visibility="Collapsed">
                            <TextBlock Text="Mattermost incoming-webhook URL (encrypted)"/><PasswordBox x:Name="MattermostWebhookBox" Padding="9,7" Margin="0,0,0,12"/>
                            <CheckBox x:Name="MattermostSilentBox" Content="Deliver silently (no desktop, push, email, unread, or mention notification)"/>
                            <TextBlock Text="Self-hosted HTTPS servers and subpath installations are supported. TLS certificate validation is always required; mention controls are suppressed." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="MatrixFields" Visibility="Collapsed">
                            <TextBlock Text="Homeserver HTTPS base URL"/><TextBox x:Name="MatrixHomeserverBox"/>
                            <TextBlock Text="Access token (encrypted)"/><PasswordBox x:Name="MatrixTokenBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Room ID beginning with ! (encrypted)"/><PasswordBox x:Name="MatrixRoomBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="The access-token account must already be joined and permitted to post. Encrypted rooms are not supported yet; mention metadata is explicitly empty." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="NtfyFields" Visibility="Collapsed">
                            <TextBlock Text="ntfy server HTTPS base URL"/><TextBox x:Name="NtfyServerBox" Text="https://ntfy.sh"/>
                            <TextBlock Text="Topic (encrypted)"/><PasswordBox x:Name="NtfyTopicBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Access token (optional, encrypted)"/><PasswordBox x:Name="NtfyTokenBox" Padding="9,7" Margin="0,0,0,8"/>
                            <CheckBox x:Name="NtfyClearTokenBox" Content="Remove stored access token"/>
                            <CheckBox x:Name="NtfyAnonymousBox" Content="Allow unauthenticated publishing (topic may be publicly readable/writable)"/>
                            <TextBlock Text="A protected self-hosted topic with a dedicated token is recommended. ntfy.sh topics are public unless account access control protects them." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="GotifyFields" Visibility="Collapsed">
                            <TextBlock Text="Gotify server HTTPS base URL (without /message)"/><TextBox x:Name="GotifyServerBox"/>
                            <TextBlock Text="Application token (encrypted)"/><PasswordBox x:Name="GotifyTokenBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Messages are sent as text/plain. Markdown, remote images, click URLs, and actions are not enabled for agent-provided content." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="PushoverFields" Visibility="Collapsed">
                            <TextBlock Text="Application API token (encrypted)"/><PasswordBox x:Name="PushoverTokenBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="User or delivery-group key (encrypted)"/><PasswordBox x:Name="PushoverUserKeyBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Device name (optional, encrypted)"/><PasswordBox x:Name="PushoverDeviceBox" Padding="9,7" Margin="0,0,0,8"/>
                            <CheckBox x:Name="PushoverClearDeviceBox" Content="Remove stored device restriction"/>
                            <TextBlock Text="Sound name (blank uses the account default; built-in or account custom)"/><TextBox x:Name="PushoverSoundBox"/>
                            <CheckBox x:Name="PushoverEmergencyBox" Content="Send critical notifications as repeating emergency alerts"/>
                            <TextBlock Text="Emergency retry interval in seconds (minimum 30)"/><TextBox x:Name="PushoverRetryBox" Text="60"/>
                            <TextBlock Text="Emergency expiry in seconds (1–10800)"/><TextBox x:Name="PushoverExpireBox" Text="3600"/>
                            <TextBlock Text="Emergency alerts repeat until acknowledged or expired. AgentNotify validates the returned receipt; receipt-status tracking is planned." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="PushbulletFields" Visibility="Collapsed">
                            <TextBlock Text="Personal access token (encrypted)"/><PasswordBox x:Name="PushbulletTokenBox" Padding="9,7" Margin="0,0,0,12"/>
                            <TextBlock Text="Destination"/><ComboBox x:Name="PushbulletTargetTypeBox"><ComboBoxItem Content="All devices on this account" Tag="all"/><ComboBoxItem Content="One device ID" Tag="device"/><ComboBoxItem Content="Owned channel tag" Tag="channel"/><ComboBoxItem Content="Email (may fall back to email delivery)" Tag="email"/></ComboBox>
                            <TextBlock Text="Device ID, channel tag, or email (encrypted; blank for all devices)"/><PasswordBox x:Name="PushbulletTargetBox" Padding="9,7" Margin="0,0,0,12"/>
                            <CheckBox x:Name="PushbulletQuotaBox" Content="I understand that free accounts are limited to 500 pushes per month and test sends consume quota"/>
                            <TextBlock Text="The token grants full access to the Pushbullet account. AgentNotify sends plain note pushes only—never files or active links—and uses a stable retry GUID." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                        <CheckBox x:Name="AllowPrivateBox" Content="Allow private/loopback destinations (link-local metadata remains blocked)"/>
                        <TextBlock x:Name="StoredSecretsText" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,0"><Button Content="Save provider" Click="SaveProvider_Click"/><Button Content="Send test" Click="TestProvider_Click"/></WrapPanel>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Routes">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ListBox x:Name="RouteList" Height="330" DisplayMemberPath="Name" SelectionChanged="Route_Selected"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="New" Click="NewRoute_Click"/><Button Content="Delete" Click="DeleteRoute_Click"/></WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Delivery route" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="A route sends matching new notifications to one provider." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Route name"/><TextBox x:Name="RouteNameBox"/>
                        <TextBlock Text="Provider"/><ComboBox x:Name="RouteProviderBox" DisplayMemberPath="Name"/>
                        <CheckBox x:Name="RouteEnabledBox" Content="Enable this route"/>
                        <TextBlock Text="Minimum priority"/><ComboBox x:Name="RoutePriorityBox"/>
                        <TextBlock Text="Type ID (blank = any)"/><TextBox x:Name="RouteTypeBox"/>
                        <TextBlock Text="Project (blank = any)"/><TextBox x:Name="RouteProjectBox"/>
                        <TextBlock Text="Agent (blank = any)"/><TextBox x:Name="RouteAgentBox"/>
                        <CheckBox x:Name="IncludeMessageBox" Content="Include notification message off-device"/>
                        <Button Content="Save route" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveRoute_Click"/>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <StackPanel Margin="20">
                    <TextBlock Text="Outbound delivery" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="DiagnosticsText" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="#C7D2FE"/>
                    <Button Content="Refresh diagnostics" HorizontalAlignment="Left" Click="RefreshDiagnostics_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="1" x:Name="ChannelStatusText" Margin="4,10,4,0" TextWrapping="Wrap" Foreground="#FCA5A5"/>
    </Grid>
</UserControl>
