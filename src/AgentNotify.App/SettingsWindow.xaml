<Window x:Class="AgentNotify.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentNotify.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AgentNotify Settings" Width="1040" Height="780" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#09090B" Foreground="#FAFAFA"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/an.png" Width="24" Height="24"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AgentNotify" FontWeight="SemiBold" Margin="0"/>
                    <TextBlock Text="/ Settings" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Style="{StaticResource WindowIconButton}" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Content="&#xE922;" Style="{StaticResource WindowIconButton}" Click="Maximize_Click" ToolTip="Maximize or restore"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowIconButton}" Click="Cancel_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="LOCAL CONTROL PLANE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0"/>
                <TextBlock Text="Configure the local broker, attention surfaces, and opt-in delivery routes."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <TabControl Grid.Row="1" Margin="0,20,0,18" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
                    <TextBlock Text="Local API port" FontWeight="SemiBold"/><TextBox x:Name="PortBox"/>
                    <TextBlock Text="Changing the port requires restarting AgentNotify." Foreground="{StaticResource WarningBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="History retention (days)" FontWeight="SemiBold"/><TextBox x:Name="RetentionBox"/>
                    <CheckBox x:Name="PauseBox" Content="Pause desktop toasts (notifications are still stored)"/>
                    <CheckBox x:Name="DndBox" Content="Do not disturb"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Toasts">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
                    <TextBlock Text="Screen corner" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LocationBox"><ComboBoxItem Content="BottomRight"/><ComboBoxItem Content="TopRight"/></ComboBox>
                    <TextBlock Text="Maximum visible toasts" FontWeight="SemiBold"/><TextBox x:Name="MaxVisibleBox"/>
                    <TextBlock Text="Default lifetimes in seconds (0 means sticky)" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <UniformGrid Columns="4">
                        <TextBlock Text="Info"/><TextBox x:Name="InfoDuration"/><TextBlock Text="Success"/><TextBox x:Name="SuccessDuration"/>
                        <TextBlock Text="Warning"/><TextBox x:Name="WarningDuration"/><TextBlock Text="Completed"/><TextBox x:Name="CompletedDuration"/>
                        <TextBlock Text="Error"/><TextBox x:Name="ErrorDuration"/><TextBlock Text="Input required"/><TextBox x:Name="InputDuration"/>
                        <TextBlock Text="Permission"/><TextBox x:Name="PermissionDuration"/><TextBlock Text="Blocked"/><TextBox x:Name="BlockedDuration"/>
                    </UniformGrid>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Custom types">
                <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><ListBox x:Name="CustomTypesList" Height="300" DisplayMemberPath="DisplayName" SelectionChanged="CustomType_Selected"/>
                        <Button Content="New type" Margin="0,10,0,0" Click="NewType_Click"/><Button Content="Delete selected" Margin="0,8,0,0" Click="DeleteType_Click"/>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Stable ID" FontWeight="SemiBold"/><TextBox x:Name="CustomIdBox" ToolTip="lowercase letters, numbers, and underscores"/>
                        <TextBlock Text="Display name" FontWeight="SemiBold"/><TextBox x:Name="CustomNameBox"/>
                        <TextBlock Text="Accent color" FontWeight="SemiBold"/><TextBox x:Name="CustomColorBox" ToolTip="#RRGGBB"/>
                        <TextBlock Text="Default priority" FontWeight="SemiBold"/><ComboBox x:Name="CustomPriorityBox" ItemsSource="{Binding Source={x:Static local:SettingsWindow.PriorityNames}}"/>
                        <TextBlock Text="Lifetime in seconds (0 = sticky)" FontWeight="SemiBold"/><TextBox x:Name="CustomDurationBox"/>
                        <CheckBox x:Name="CustomEnabledBox" Content="Enabled"/>
                        <Button Content="Apply type changes" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ApplyType_Click"/>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Sounds">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
                    <CheckBox x:Name="SoundsBox" Content="Enable notification sounds"/>
                    <TextBlock Text="Volume (0–100)" FontWeight="SemiBold"/><TextBox x:Name="SoundVolumeBox"/>
                    <CheckBox x:Name="CriticalSoundDndBox" Content="Allow critical sounds during Do Not Disturb"/>
                    <TextBlock Text="Built-in tone" FontWeight="SemiBold"/><ComboBox x:Name="GlobalBuiltInBox" SelectionChanged="GlobalBuiltIn_Selected"/>
                    <TextBlock Text="Global WAV/MP3" FontWeight="SemiBold"/><TextBox x:Name="GlobalSoundBox" IsReadOnly="True"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Button Content="Choose…" Margin="0" Click="ChooseGlobalSound_Click"/><Button Content="Preview" Click="PreviewGlobalSound_Click"/><Button Content="Clear" Click="ClearGlobalSound_Click"/></StackPanel>
                    <TextBlock Text="Per-type override" FontWeight="SemiBold"/><ComboBox x:Name="SoundTypeBox" SelectionChanged="SoundType_Selected"/>
                    <TextBlock Text="Built-in tone" FontWeight="SemiBold"/><ComboBox x:Name="TypeBuiltInBox" SelectionChanged="TypeBuiltIn_Selected"/>
                    <TextBox x:Name="TypeSoundBox" IsReadOnly="True"/>
                    <StackPanel Orientation="Horizontal"><Button Content="Choose…" Margin="0" Click="ChooseTypeSound_Click"/><Button Content="Preview" Click="PreviewTypeSound_Click"/><Button Content="Use global" Click="ClearTypeSound_Click"/></StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Channels">
                <local:ChannelSettingsPanel x:Name="ChannelPanel"/>
            </TabItem>
            <TabItem Header="Install" x:Name="InstallTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
                    <TextBlock Text="Install the agent skill" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,4">
                        The skill is a Markdown file that teaches a coding agent when to notify you: before it
                        waits on a decision, when a long task finishes, when something blocks it. Installing copies
                        it into that agent&#39;s own skills folder. Nothing else on this machine changes, and nothing
                        is sent anywhere.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18">
                        An agent picks the file up the next time it starts.
                    </TextBlock>

                    <ItemsControl x:Name="SkillTargetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Destination}" Foreground="{StaticResource DisabledTextBrush}"
                                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Choose folder&#8230;" Tag="{Binding}" Click="ChooseSkillFolder_Click"
                                                    ToolTip="Point this at the folder your agent loads skills from"/>
                                            <Button Content="Open" Tag="{Binding}" Click="OpenSkillFolder_Click"
                                                    IsEnabled="{Binding CanInstall}" ToolTip="Show the folder in Explorer"/>
                                            <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="InstallSkill_Click"
                                                    IsEnabled="{Binding CanInstall}" Style="{StaticResource PrimaryButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0">
                        The same install is available without this window:
                        <Run FontFamily="Consolas" Foreground="{StaticResource TextBrush}">agentnotify install-skill claude</Run>
                        &#8212; add <Run FontFamily="Consolas">--scope project</Run> to install it into the current repository instead.
                    </TextBlock>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="About" x:Name="AboutTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Image Source="pack://application:,,,/Resources/an.png" Width="72" Height="72"
                               VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AgentNotify" FontSize="26" FontWeight="Bold"/>
                            <TextBlock x:Name="AboutVersionText" Foreground="{StaticResource MutedTextBrush}" FontSize="13"/>
                            <TextBlock x:Name="AboutPrereleaseText" Foreground="{StaticResource WarningBrush}" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16">
                        The local human-attention broker for coding agents. Agents send a small authenticated
                        request over loopback; AgentNotify shows a desktop notification, keeps the event in local
                        SQLite history, and makes unresolved requests visible from the tray. It answers one
                        question reliably: which agents are waiting for you?
                    </TextBlock>

                    <TextBlock Text="Local first" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16">
                        The API is bound to 127.0.0.1 and requires a bearer token. Notification history stays on
                        this machine. Outbound channels are opt-in and stay disabled until you configure and
                        enable both a provider and a matching route. There is no telemetry.
                    </TextBlock>

                    <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,6,0,6"/>
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink NavigateUri="https://github.com/Akash97p/agent-notify"
                                   RequestNavigate="AboutLink_RequestNavigate">Source code on GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink NavigateUri="https://akash97p.github.io/agent-notify/"
                                   RequestNavigate="AboutLink_RequestNavigate">Documentation</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink NavigateUri="https://github.com/Akash97p/agent-notify/releases"
                                   RequestNavigate="AboutLink_RequestNavigate">Releases and changelog</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,16">
                        <Hyperlink NavigateUri="https://github.com/Akash97p/agent-notify/issues"
                                   RequestNavigate="AboutLink_RequestNavigate">Report a problem</Hyperlink>
                    </TextBlock>

                    <TextBlock Text="Local data" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBlock x:Name="AboutDataPathText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16">
                        config.json contains the local bearer token. Do not share or commit it.
                    </TextBlock>

                    <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="AboutPublisherText" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock Foreground="{StaticResource DisabledTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="MIT licensed. Provided as is, without warranty of any kind. Binaries are not code-signed."/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" Margin="0,0,16,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Click="Cancel_Click"/>
                    <Button Content="Save settings" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
