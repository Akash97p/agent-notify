<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AgentNotify.Tray</AssemblyName>
    <RootNamespace>AgentNotify.App</RootNamespace>
    <Description>AgentNotify — human-attention broker for coding agents (tray app).</Description>
    <AssemblyTitle>AgentNotify Tray</AssemblyTitle>
    <ApplicationIcon>..\..\assets\branding\an.ico</ApplicationIcon>
    <StartupObject>AgentNotify.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentNotify.Api\AgentNotify.Api.csproj" />
    <ProjectReference Include="..\AgentNotify.Core\AgentNotify.Core.csproj" />
    <ProjectReference Include="..\AgentNotify.Router\AgentNotify.Router.csproj" />
    <ProjectReference Include="..\AgentNotify.Insights\AgentNotify.Insights.csproj" />
    <ProjectReference Include="..\AgentNotify.Protocol\AgentNotify.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\branding\an.ico" Link="Resources\an.ico" />
    <!-- 512x512 source for on-screen logos; the ICO decoder picks a small frame
         for a sized Image and renders soft. -->
    <Resource Include="..\..\assets\branding\an.png" Link="Resources\an.png" />
    <EmbeddedResource Include="..\..\distribution\agentnotify\SKILL.md" LogicalName="AgentNotify.Resources.SKILL.md" />
    <!-- Codex reads a descriptor beside the Markdown, so the Install tab has to
         be able to write one. Every other agent gets the Markdown alone. -->
    <EmbeddedResource Include="..\..\distribution\agentnotify\agents\openai.yaml" LogicalName="AgentNotify.Resources.openai.yaml" />
    <EmbeddedResource Include="..\..\assets\GettingStarted.html" LogicalName="AgentNotify.Resources.GettingStarted.html" />
    <EmbeddedResource Include="..\..\assets\tones\*.wav" LogicalName="AgentNotify.Resources.Tones.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
