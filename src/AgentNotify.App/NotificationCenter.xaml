<Window x:Class="AgentNotify.App.NotificationCenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentNotify — Notification Center"
        Height="560" Width="560" MinHeight="380" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#0F1117">
    <Window.Resources>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2431"/>
            <Setter Property="Foreground" Value="#C6CADF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3044"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1F2B" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AgentNotify" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="Subtitle" Text="Notifications from your agents" FontSize="11" Foreground="#7B819A" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Width="24" Height="24" Background="Transparent" BorderThickness="0"
                        Foreground="#7B819A" Click="OnCloseClick"/>
            </Grid>
        </Border>

        <!-- Needs attention header + count -->
        <Grid Grid.Row="1" Margin="16,12,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Needs attention" FontWeight="SemiBold" FontSize="12" Foreground="#E8EAFF" VerticalAlignment="Center"/>
                <Border x:Name="ActiveCountPill" Style="{StaticResource Pill}" Background="#2E9E5B" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ActiveCountText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" x:Name="DismissAllButton" Content="Dismiss all" Style="{StaticResource GhostButton}"
                    Click="OnDismissAllClick"/>
        </Grid>

        <!-- Active list -->
        <Border Grid.Row="2" Margin="16,0,16,0" Background="#171B25" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ActivePanel" Margin="0,4,0,4"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="ActiveEmpty" Grid.Row="2" Text="Nothing needs attention." Foreground="#5E657E"
                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- History header -->
        <TextBlock Grid.Row="3" Text="Recent" FontWeight="SemiBold" FontSize="12" Foreground="#E8EAFF"
                   Margin="16,14,16,6"/>

        <!-- Recent list -->
        <Border Grid.Row="4" Margin="16,0,16,0" Background="#171B25" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RecentPanel" Margin="0,4,0,4"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="RecentEmpty" Grid.Row="4" Text="No recent notifications." Foreground="#5E657E"
                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- Footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10">
            <Button Content="Refresh" Style="{StaticResource GhostButton}" Click="OnRefreshClick"/>
        </StackPanel>
    </Grid>
</Window>
