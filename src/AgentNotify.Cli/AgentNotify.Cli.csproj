<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentnotify</AssemblyName>
    <RootNamespace>AgentNotify.Cli</RootNamespace>
    <Description>agentnotify — command-line client for the AgentNotify broker.</Description>
    <AssemblyTitle>AgentNotify Command Line</AssemblyTitle>
    <ApplicationIcon>..\..\an.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentNotify.Contracts\AgentNotify.Contracts.csproj" />
    <ProjectReference Include="..\AgentNotify.Core\AgentNotify.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentNotify.Tests" />
  </ItemGroup>

</Project>
