<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentnotify</AssemblyName>
    <RootNamespace>AgentNotify.Cli</RootNamespace>
    <Description>agentnotify — command-line client for the AgentNotify broker.</Description>
    <AssemblyTitle>AgentNotify Command Line</AssemblyTitle>
    <ApplicationIcon>..\..\assets\branding\an.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentNotify.Protocol\AgentNotify.Protocol.csproj" />
    <ProjectReference Include="..\AgentNotify.Core\AgentNotify.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentNotify.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\distribution\agentnotify\SKILL.md"
                      LogicalName="AgentNotify.Cli.Resources.agentnotify.SKILL.md" />
    <EmbeddedResource Include="..\..\distribution\agentnotify\agents\openai.yaml"
                      LogicalName="AgentNotify.Cli.Resources.agentnotify.agents.openai.yaml" />
    <EmbeddedResource Include="..\..\distribution\harness\opencode\agentnotify.js"
                      LogicalName="AgentNotify.Cli.Resources.harness.opencode.agentnotify.js" />
    <EmbeddedResource Include="..\..\distribution\harness\shared\agentnotify_hook.py"
                      LogicalName="AgentNotify.Cli.Resources.harness.shared.agentnotify_hook.py" />
  </ItemGroup>

</Project>
