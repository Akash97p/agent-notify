<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>AgentNotify domain, configuration, persistence and services. No UI or ASP.NET dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- X25519 and ChaCha20-Poly1305 for relay envelope sealing. Pure managed, so
         the single-file installer carries no native binary per runtime identifier. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentNotify.Protocol\AgentNotify.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentNotify.Tests" />
    <InternalsVisibleTo Include="AgentNotify.Router" />
    <InternalsVisibleTo Include="AgentNotify.Insights" />
  </ItemGroup>

</Project>
