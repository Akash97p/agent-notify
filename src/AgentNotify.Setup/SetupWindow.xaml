<Window x:Class="AgentNotify.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install AgentNotify" Width="780" Height="670"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#09090B"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="CaretBrush" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                    VerticalAlignment="Center" Background="#18181B"
                                    BorderBrush="#3F3F46" BorderThickness="1">
                                <Path x:Name="Tick" Width="10" Height="10" Stretch="Uniform"
                                      Stroke="#09090B" StrokeThickness="2" Visibility="Collapsed"
                                      Data="M 0,5 L 4,9 L 10,1"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FAFAFA"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FAFAFA"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="Padding" Value="15,9"/>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Background="#0E0E11">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0E0E11" BorderBrush="#27272A" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="OnDragWindow">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/an.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AgentNotify" Foreground="#FAFAFA" Margin="9,0,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="/ Setup" Foreground="#A1A1AA" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="&#xE8BB;" Style="{StaticResource WindowButton}"
                            Click="OnClose" ToolTip="Close"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="42,30,42,26">
                    <StackPanel Orientation="Horizontal">
                        <!-- PNG rather than ICO: the icon decoder selects a low-resolution
                             frame for a sized Image, which looks soft at 76px. -->
                        <Image Source="/Resources/an.png" Width="76" Height="76" Margin="0,0,20,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AgentNotify" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="32"/>
                            <TextBlock Text="Human attention infrastructure for coding agents" Foreground="#A1A1AA" FontSize="15"/>
                            <TextBlock x:Name="VersionText" Foreground="#71717A" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="INSTALL LOCATION" Foreground="#A1A1AA" FontWeight="SemiBold"
                               FontSize="10" Margin="0,28,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPath"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}"
                                Margin="9,0,0,0" Click="OnBrowse"/>
                    </Grid>

                    <StackPanel Margin="0,15,0,0">
                        <CheckBox x:Name="StartWithWindows" Content="Start AgentNotify when I sign in" IsChecked="True"/>
                        <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut"/>
                        <CheckBox x:Name="LaunchAfterInstall" Content="Launch AgentNotify after installation" IsChecked="True"/>
                        <CheckBox x:Name="OpenGuide" Content="Open the getting-started guide when setup closes" IsChecked="True"/>
                    </StackPanel>

                    <Border Background="#111113" BorderBrush="#27272A" BorderThickness="1"
                            CornerRadius="9" Padding="17" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Open-source licence and warranty" Foreground="#FAFAFA" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#A1A1AA" Margin="0,7,0,10"
                                       Text="AgentNotify is licensed under the permissive MIT License. The software is provided “AS IS”, without warranty of any kind, express or implied. Kabani Tech Private Limited, Akash P, and contributors are not liable for claims, damages, or other liability arising from its use."/>
                            <Button Content="Read full MIT License" HorizontalAlignment="Left"
                                    Style="{StaticResource GhostButton}" Click="OnLicense"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="AcceptTerms" Margin="0,15,0,0" Checked="OnAcceptanceChanged" Unchecked="OnAcceptanceChanged">
                        <TextBlock TextWrapping="Wrap" Text="I have read and accept the MIT License and understand the no-warranty notice."/>
                    </CheckBox>

                    <ProgressBar x:Name="Progress" Height="4" Margin="0,20,0,0" Minimum="0" Maximum="100"
                                 Value="0" Foreground="#FAFAFA" Background="#27272A"/>
                    <TextBlock x:Name="StatusText" Text="Ready to install" Foreground="#A1A1AA" Margin="0,9,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#27272A" BorderThickness="0,1,0,0"
                    Background="#0E0E11" CornerRadius="0,0,11,11">
                <Grid Margin="42,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KABANI TECH PRIVATE LIMITED" Foreground="#71717A" FontSize="10"
                                   FontWeight="SemiBold"/>
                        <Button Content="Akash P · github.com/Akash97p" HorizontalAlignment="Left"
                                Padding="0" Margin="0,4,0,0" Background="Transparent" BorderThickness="0"
                                Foreground="#D4D4D8" Cursor="Hand" Click="OnAuthor"/>
                    </StackPanel>
                    <Button x:Name="InstallButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Content="Install AgentNotify" Style="{StaticResource ActionButton}"
                            IsEnabled="False" Click="OnInstall"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
