{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akash97p.github.io/agent-notify/schemas/aep-agentnotify-profile-0.1.schema.json",
  "title": "AgentNotify AEP Human Attention Profile 0.1",
  "description": "The AEP 0.1 notification.sent and question.asked subset accepted by AgentNotify.",
  "type": "object",
  "required": ["aep_version", "id", "type", "time", "agent", "content"],
  "properties": {
    "aep_version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "type": { "enum": ["notification.sent", "question.asked"] },
    "time": { "type": "string", "format": "date-time" },
    "hook": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["slug"],
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 100 },
        "display_name": { "type": "string" },
        "version": { "type": "string" },
        "instance_id": { "type": "string", "maxLength": 100 },
        "surface": { "type": "string" }
      },
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversation_id": { "type": "string" },
        "turn_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "properties": {
        "cwd": { "type": "string", "maxLength": 1024 },
        "project_path": { "type": "string" },
        "roots": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": { "enum": ["notification", "question"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "style": { "type": "string" },
          "truncated": { "type": "boolean" },
          "original_length": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "x-agentnotify": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "notification_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "priority": { "enum": ["low", "normal", "high", "critical"] },
            "key": { "type": "string", "maxLength": 100 },
            "project": { "type": "string", "maxLength": 200 },
            "pid": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^x-[a-z0-9.-]+$": true },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "notification.sent" } } },
      "then": {
        "properties": {
          "content": { "contains": { "properties": { "type": { "const": "notification" } }, "required": ["type"] } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "question.asked" } } },
      "then": {
        "properties": {
          "content": { "contains": { "properties": { "type": { "const": "question" } }, "required": ["type"] } }
        }
      }
    }
  ],
  "additionalProperties": true
}
