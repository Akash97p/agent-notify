<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core Minimal API host for AgentNotify (loopback + bearer auth).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUi\wwwroot\**\*" LogicalName="AgentNotify.WebUi/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\distribution\agentnotify\SKILL.md" LogicalName="AgentNotify.Api.Resources.SKILL.md" />
    <EmbeddedResource Include="..\..\distribution\agentnotify\agents\openai.yaml" LogicalName="AgentNotify.Api.Resources.openai.yaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentNotify.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentNotify.Core\AgentNotify.Core.csproj" />
    <ProjectReference Include="..\AgentNotify.Protocol\AgentNotify.Protocol.csproj" />
  </ItemGroup>

</Project>
